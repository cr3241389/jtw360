{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(gemini_theme\\.css|liquid_glass\\.js|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/places/:slug", "destination": "/index.html?place=:slug" },
    { "source": "/guides/:slug", "destination": "/index.html?guide=:slug" },
    { "source": "/food/:slug", "destination": "/index.html?place=:slug" },
    { "source": "/parking/:slug", "destination": "/index.html?place=:slug" }
  ]
}
